		"start_boss":[
			{"text":"让我们开始吧！"},
			{"text":"逐鹿星河！"},
			{"text":"这将会是一段激动人心的大冒险！"},
		],
		"retreat":[
			{"text":"好的老大！都听你的。"},
			{"text":"开始撤退."},
