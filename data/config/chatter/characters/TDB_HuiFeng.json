		"pursuing":[
			{"text":"快追！我和老大的假期要跑了！"},
			{"text":"该大肆践踏了."},
			{"text":"结束了？"},
			{"text":"别想逃出这片火海!"},
		],
		"running":[
			{"text":"正在移动."},
		],
		"hull_90":[
			{"text":"小伤而已."},
			{"text":"舰体轻微受损."},
		],
		"hull_50":[
			{"text":"放心老大,我还应付的了···大概."},
			{"text":"正在重塑舰体！"},
		],
		"hull_30":[
			{"text":"合同还没到期！"},
			{"text":"紧急舰体重塑！"},
